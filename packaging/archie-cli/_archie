#compdef archie

_archie() {
  local -a commands actions get_settings set_settings behaviors global_options status_options initialize_options downgrade_options

  commands=(
    'applet:Run the Archie tray applet'
    'downgrade:Resolve Arch Linux Archive package URLs for pacman -U'
    'gui:Open Archie graphical controls'
    'system:Manage Archie-owned system policy'
  )
  actions=(
    'get:Read an Archie-owned system setting'
    'initialize-store:Initialize shared Archie store'
    'status:Summarize current system status'
    'set:Change an Archie-owned system setting'
  )
  get_settings=(
    'lid-close-behavior:Read lid close behavior'
    'notifications:Read dunst notification state'
    'notification-sounds:Read notification sound state'
    'notification-sound:Read notification sound path'
    'shy-mode:Read shy mode notification privacy settings'
    'share-state:Read screen-share state'
    'kdeconnect:Read KDE Connect daemon state'
    'power-profile:Read active power profile'
    'waybar-theme:Read active Waybar theme'
    'waybar-tooltip-font-family:Read Waybar tooltip font family'
    'waybar-tooltip-font-size:Read Waybar tooltip font size'
    'brightness:Read screen brightness state'
    'monitors:Read Hyprland monitor state'
  )
  set_settings=(
    'lid-close-behavior:Manage lid close behavior'
    'notifications:Manage dunst notification state'
    'notification-sounds:Manage notification sound state'
    'notification-sound:Manage notification sound path'
    'shy-mode:Manage shy mode notification privacy'
    'kdeconnect:Manage KDE Connect backends'
    'power-profile:Manage active power profile'
    'waybar-theme:Manage active Waybar theme'
    'waybar-tooltip-font-family:Manage Waybar tooltip font family'
    'waybar-tooltip-font-size:Manage Waybar tooltip font size'
    'brightness:Manage screen brightness'
  )
  behaviors=(
    'hibernate:Use systemd-logind hybrid-sleep'
    'lock:Lock after reopening'
    'none:Ignore lid close events'
  )
  global_options=(
    '--help:show help and exit'
    '--help-all:show all commands hierarchically and exit'
  )
  status_options=(
    '--help:show help and exit'
    '(-f --format -j --json)'{-f,--format}'[output format]:format:(table json)'
    '(-f --format -j --json)'{-j,--json}'[render as JSON]'
  )
  initialize_options=(
    '--help:show help and exit'
    '--legacy-home[absolute legacy home directory]:directory:_directories'
  )
  downgrade_options=(
    '--help:show help and exit'
    '--to:target time: YYYY-MM-DD, 7d, or 4h'
    '--archive-url:archive root URL'
    '--execute:run the resolved downgrade with pacman'
    '--noconfirm:pass --noconfirm to pacman'
  )

  if [[ "$words[CURRENT]" == -* ]]; then
    case "$words[2]" in
      downgrade)
        _describe -t options 'downgrade option' downgrade_options
        ;;
      system)
        case "$words[3]" in
          status) _describe -t options 'system status option' status_options ;;
          initialize-store) _describe -t options 'store initialization option' initialize_options ;;
          *) _describe -t options 'archie option' global_options ;;
        esac
        ;;
      *)
        _describe -t options 'archie option' global_options
        ;;
    esac
    return
  fi

  case "$CURRENT:$words[2]:$words[3]:$words[4]" in
    2:*)
      _describe -t commands 'archie command' commands
      ;;
    3:system:*)
      _describe -t actions 'system action' actions
      ;;
    4:system:get:*)
      _describe -t settings 'system setting' get_settings
      ;;
    4:system:set:*)
      _describe -t settings 'system setting' set_settings
      ;;
    5:system:set:lid-close-behavior)
      _describe -t behaviors 'lid close behavior' behaviors
      ;;
    *:downgrade:*)
      _archie_pacman_packages
      ;;
  esac
}

_archie_pacman_packages() {
  if (( $+functions[_pacman_completions_all_packages] )); then
    _pacman_completions_all_packages
  elif (( $+functions[_pacman] )); then
    _pacman
  else
    _files
  fi
}

_archie "$@"
