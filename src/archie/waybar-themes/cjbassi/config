// -*- mode: json -*-

{
    "layer": "top",
    "position": "top",

    "modules-left": [
        "tray",
        "custom/right-arrow-dark",
        "custom/right-arrow-light",
        "cpu",
        "custom/right-arrow-dark",
        "custom/right-arrow-light",
        "custom/memory",
        "custom/right-arrow-dark",
        "custom/right-arrow-light",
        "custom/disk",
        "custom/right-arrow-dark"
    ],
    "modules-center": [
        "custom/left-arrow-dark",
        "clock#1",
        "custom/left-arrow-light",
        "custom/left-arrow-dark",
        "clock#2",
        "custom/right-arrow-dark",
        "custom/right-arrow-light",
        "clock#3",
        "custom/right-arrow-dark"
    ],
    "modules-right": [
        "custom/share",
        "custom/cam",
        "custom/mic",
        "custom/left-arrow-dark",
        "custom/sound",
        "custom/left-arrow-light",
        "custom/left-arrow-dark",
        "custom/battery",
        "custom/left-arrow-light",
        "custom/left-arrow-dark",
        "hyprland/workspaces"
    ],

    "custom/left-arrow-dark": {
        "format": "",
        "tooltip": false
    },
    "custom/left-arrow-light": {
        "format": "",
        "tooltip": false
    },
    "custom/right-arrow-dark": {
        "format": "",
        "tooltip": false
    },
    "custom/right-arrow-light": {
        "format": "",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "clock#1": {
        "format": "{:%m-%d}",
        "tooltip": false,
        "on-click-right": "archie system open calendar --view month --click right"
    },
    "clock#2": {
        "format": "{:%H:%M}",
        "tooltip": false
    },
    "clock#3": {
        "format": " {:%a} ",
        "tooltip": false
    },

   "custom/share": {
        "format": "<span foreground=\"red\"> {} </span>",
        "exec": "~/.config/hypr/scripts/waybar-share-indicator.sh",
        "interval": 5
    },
    "custom/cam": {
        "format": "<span foreground=\"red\"> {} </span>",
        "exec": "~/.config/hypr/scripts/waybar-cam-indicator.sh",
        "interval": 5
    },
    "custom/mic": {
        "format": "<span foreground=\"red\"> {} </span>",
        "exec": "~/.config/hypr/scripts/waybar-mic-indicator.sh",
        "interval": 5
    },
    "idle_inhibitor": {
        "format": " {icon} ",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "custom/sound": {
        "interval": 5,
        "format": "{text}",
        "exec": "~/.config/hypr/scripts/waybar-sound-indicator.sh",
        "return-type": "json",
        "on-click": "pavucontrol",
        "on-click-right": "pamixer -t",
        "on-scroll-up": "pamixer -d 1",
        "on-scroll-down": "pamixer -i 1"
    },
    "custom/memory": {
        "interval": 5,
        "format": " {text}",
        "exec": "~/.config/hypr/scripts/waybar-memory-indicator.sh",
        "return-type": "json",
        "on-click": "gnome-system-monitor --show-processes-tab"
    },
    "cpu": {
        "interval": 5,
        "format": " {usage:2}%",
        "on-click": "kitty htop",
        "on-click-right": "gnome-system-monitor --show-resources-tab"
    },
    "custom/battery": {
        "interval": 5,
        "format": "{text}",
        "exec": "~/.config/hypr/scripts/waybar-battery-indicator.sh",
        "return-type": "json",
        "on-click": "tlpui"
    },
    "custom/disk": {
        "interval": 5,
        "format": "󱛟 {text}",
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/waybar-disk-indicator.sh",
        "on-click": "kitty ncdu ~",
        "on-click-right": "gnome-system-monitor --show-file-systems-tab"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 1
    }
}
